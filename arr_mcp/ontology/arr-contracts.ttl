arr:contract-arr-remove-stalled-download a arr:ToolUseContract ;
    rdfs:label "Remove a stalled download and find another" ;
    rdfs:comment "Remove one stalled or failed queue item, blocklist the release so it is not grabbed again, and search again." ;
    arr:contractOf arr:skill-arr-download-queue ;
    arr:hasStep arr:step-arr-remove-stalled-download-1, arr:step-arr-remove-stalled-download-2, arr:step-arr-remove-stalled-download-3 .

arr:step-arr-remove-stalled-download-1 a arr:ContractStep ;
    arr:stepIndex 1 ;
    arr:callsTool arr:tool-radarr_get_queue ;
    arr:needsApproval false ;
    rdfs:comment "Pick the stalled item (`id`, `movieId`)." ;
    arr:precedesStep arr:step-arr-remove-stalled-download-2 ;
    arr:bindsParameter arr:param-arr-remove-stalled-download-1-status ;
    arr:bindsParameter arr:param-arr-remove-stalled-download-1-includeMovie .

arr:param-arr-remove-stalled-download-1-status a arr:ParameterBinding ;
    arr:parameterName "status" ;
    arr:parameterSource "const:[\"warning\", \"failed\"]" .

arr:param-arr-remove-stalled-download-1-includeMovie a arr:ParameterBinding ;
    arr:parameterName "includeMovie" ;
    arr:parameterSource "const:true" .

arr:step-arr-remove-stalled-download-2 a arr:ContractStep ;
    arr:stepIndex 2 ;
    arr:callsTool arr:tool-radarr_delete_queue_id ;
    arr:needsApproval true ;
    rdfs:comment "Approval required: deletes the download from qBittorrent." ;
    arr:precedesStep arr:step-arr-remove-stalled-download-3 ;
    arr:bindsParameter arr:param-arr-remove-stalled-download-2-id ;
    arr:bindsParameter arr:param-arr-remove-stalled-download-2-removeFromClient ;
    arr:bindsParameter arr:param-arr-remove-stalled-download-2-blocklist ;
    arr:bindsParameter arr:param-arr-remove-stalled-download-2-confirm .

arr:param-arr-remove-stalled-download-2-id a arr:ParameterBinding ;
    arr:parameterName "id" ;
    arr:parameterSource "step1.records[].id" .

arr:param-arr-remove-stalled-download-2-removeFromClient a arr:ParameterBinding ;
    arr:parameterName "removeFromClient" ;
    arr:parameterSource "const:true" .

arr:param-arr-remove-stalled-download-2-blocklist a arr:ParameterBinding ;
    arr:parameterName "blocklist" ;
    arr:parameterSource "const:true" .

arr:param-arr-remove-stalled-download-2-confirm a arr:ParameterBinding ;
    arr:parameterName "confirm" ;
    arr:parameterSource "const:true" .

arr:step-arr-remove-stalled-download-3 a arr:ContractStep ;
    arr:stepIndex 3 ;
    arr:callsTool arr:tool-radarr_post_command ;
    arr:needsApproval false ;
    rdfs:comment "Search for another release." ;
    arr:bindsParameter arr:param-arr-remove-stalled-download-3-data .

arr:param-arr-remove-stalled-download-3-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "const:{\"name\": \"MoviesSearch\", \"movieIds\": [<step1.movieId>]}" .

arr:contract-arr-suite-health-check a arr:ToolUseContract ;
    rdfs:label "Check suite health" ;
    rdfs:comment "Read every app's status and health, and report versions, connectivity and open health issues." ;
    arr:contractOf arr:skill-arr-mcp-operations ;
    arr:hasStep arr:step-arr-suite-health-check-1, arr:step-arr-suite-health-check-2, arr:step-arr-suite-health-check-3, arr:step-arr-suite-health-check-4, arr:step-arr-suite-health-check-5, arr:step-arr-suite-health-check-6, arr:step-arr-suite-health-check-7, arr:step-arr-suite-health-check-8, arr:step-arr-suite-health-check-9, arr:step-arr-suite-health-check-10, arr:step-arr-suite-health-check-11, arr:step-arr-suite-health-check-12, arr:step-arr-suite-health-check-13 .

arr:step-arr-suite-health-check-1 a arr:ContractStep ;
    arr:stepIndex 1 ;
    arr:callsTool arr:tool-radarr_get_system_status ;
    arr:needsApproval false ;
    rdfs:comment "Version and instance name." ;
    arr:precedesStep arr:step-arr-suite-health-check-2 .

arr:step-arr-suite-health-check-2 a arr:ContractStep ;
    arr:stepIndex 2 ;
    arr:callsTool arr:tool-radarr_get_health ;
    arr:needsApproval false ;
    rdfs:comment "Open health issues." ;
    arr:precedesStep arr:step-arr-suite-health-check-3 .

arr:step-arr-suite-health-check-3 a arr:ContractStep ;
    arr:stepIndex 3 ;
    arr:callsTool arr:tool-sonarr_get_system_status ;
    arr:needsApproval false ;
    arr:precedesStep arr:step-arr-suite-health-check-4 .

arr:step-arr-suite-health-check-4 a arr:ContractStep ;
    arr:stepIndex 4 ;
    arr:callsTool arr:tool-sonarr_get_health ;
    arr:needsApproval false ;
    arr:precedesStep arr:step-arr-suite-health-check-5 .

arr:step-arr-suite-health-check-5 a arr:ContractStep ;
    arr:stepIndex 5 ;
    arr:callsTool arr:tool-lidarr_get_system_status ;
    arr:needsApproval false ;
    arr:precedesStep arr:step-arr-suite-health-check-6 .

arr:step-arr-suite-health-check-6 a arr:ContractStep ;
    arr:stepIndex 6 ;
    arr:callsTool arr:tool-lidarr_get_health ;
    arr:needsApproval false ;
    arr:precedesStep arr:step-arr-suite-health-check-7 .

arr:step-arr-suite-health-check-7 a arr:ContractStep ;
    arr:stepIndex 7 ;
    arr:callsTool arr:tool-chaptarr_get_system_status ;
    arr:needsApproval false ;
    arr:precedesStep arr:step-arr-suite-health-check-8 .

arr:step-arr-suite-health-check-8 a arr:ContractStep ;
    arr:stepIndex 8 ;
    arr:callsTool arr:tool-chaptarr_get_health ;
    arr:needsApproval false ;
    arr:precedesStep arr:step-arr-suite-health-check-9 .

arr:step-arr-suite-health-check-9 a arr:ContractStep ;
    arr:stepIndex 9 ;
    arr:callsTool arr:tool-prowlarr_get_system_status ;
    arr:needsApproval false ;
    arr:precedesStep arr:step-arr-suite-health-check-10 .

arr:step-arr-suite-health-check-10 a arr:ContractStep ;
    arr:stepIndex 10 ;
    arr:callsTool arr:tool-prowlarr_get_health ;
    arr:needsApproval false ;
    rdfs:comment "Failing indexers show here." ;
    arr:precedesStep arr:step-arr-suite-health-check-11 .

arr:step-arr-suite-health-check-11 a arr:ContractStep ;
    arr:stepIndex 11 ;
    arr:callsTool arr:tool-bazarr_get_system_status ;
    arr:needsApproval false ;
    rdfs:comment "Empty Sonarr or Radarr version means not connected." ;
    arr:precedesStep arr:step-arr-suite-health-check-12 .

arr:step-arr-suite-health-check-12 a arr:ContractStep ;
    arr:stepIndex 12 ;
    arr:callsTool arr:tool-bazarr_get_system_health ;
    arr:needsApproval false ;
    arr:precedesStep arr:step-arr-suite-health-check-13 .

arr:step-arr-suite-health-check-13 a arr:ContractStep ;
    arr:stepIndex 13 ;
    arr:callsTool arr:tool-seerr_get_status ;
    arr:needsApproval false ;
    rdfs:comment "Version and pending update." .

