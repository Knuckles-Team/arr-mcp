    arr:parameterName "filter" ;
    arr:parameterSource "const:\"all\"" .

arr:param-seerr-request-title-4-take a arr:ParameterBinding ;
    arr:parameterName "take" ;
    arr:parameterSource "const:5" .

arr:contract-seerr-retry-failed a arr:ToolUseContract ;
