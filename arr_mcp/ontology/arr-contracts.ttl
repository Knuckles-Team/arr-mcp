    arr:parameterSource "const:50" .

arr:contract-bazarr-download-wanted-subtitles a arr:ToolUseContract ;
    rdfs:label "Download wanted subtitles" ;
    rdfs:comment "Check that Bazarr is connected to Sonarr and Radarr, list the episodes and movies missing subtitles, and download one for each." ;
    arr:contractOf arr:skill-arr-subtitle-management ;
    arr:hasStep arr:step-bazarr-download-wanted-subtitles-1, arr:step-bazarr-download-wanted-subtitles-2, arr:step-bazarr-download-wanted-subtitles-3, arr:step-bazarr-download-wanted-subtitles-4, arr:step-bazarr-download-wanted-subtitles-5, arr:step-bazarr-download-wanted-subtitles-6 .

arr:step-bazarr-download-wanted-subtitles-1 a arr:ContractStep ;
    arr:stepIndex 1 ;
    arr:callsTool arr:tool-bazarr_get_system_status ;
    arr:needsApproval false ;
    rdfs:comment "Empty `sonarr_version` or `radarr_version` means Bazarr is not connected to that app: stop and report it." ;
    arr:precedesStep arr:step-bazarr-download-wanted-subtitles-2 .

arr:step-bazarr-download-wanted-subtitles-2 a arr:ContractStep ;
    arr:stepIndex 2 ;
    arr:callsTool arr:tool-bazarr_get_providers ;
    arr:needsApproval false ;
    rdfs:comment "No enabled provider means no subtitle can be found: stop and report it." ;
    arr:precedesStep arr:step-bazarr-download-wanted-subtitles-3 .

arr:step-bazarr-download-wanted-subtitles-3 a arr:ContractStep ;
    arr:stepIndex 3 ;
    arr:callsTool arr:tool-bazarr_get_episodes_wanted ;
    arr:needsApproval false ;
    rdfs:comment "Episodes missing subtitles (`sonarrSeriesId`, `sonarrEpisodeId`, `missing_subtitles`)." ;
