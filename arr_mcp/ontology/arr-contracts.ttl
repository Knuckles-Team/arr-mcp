    arr:parameterSource "const:1" .

arr:contract-chaptarr-search-missing a arr:ToolUseContract ;
    rdfs:label "Search for missing books" ;
    rdfs:comment "List monitored books with no file and start one book search." ;
    arr:contractOf arr:skill-arr-book-library ;
    arr:hasStep arr:step-chaptarr-search-missing-1, arr:step-chaptarr-search-missing-2 .

arr:step-chaptarr-search-missing-1 a arr:ContractStep ;
    arr:stepIndex 1 ;
    arr:callsTool arr:tool-chaptarr_get_wanted_missing ;
    arr:needsApproval false ;
    rdfs:comment "Collect book ids." ;
    arr:precedesStep arr:step-chaptarr-search-missing-2 ;
    arr:bindsParameter arr:param-chaptarr-search-missing-1-monitored .

arr:param-chaptarr-search-missing-1-monitored a arr:ParameterBinding ;
    arr:parameterName "monitored" ;
    arr:parameterSource "const:true" .

arr:step-chaptarr-search-missing-2 a arr:ContractStep ;
    arr:stepIndex 2 ;
    arr:callsTool arr:tool-chaptarr_post_command ;
    arr:needsApproval false ;
    rdfs:comment "One command per batch." ;
    arr:bindsParameter arr:param-chaptarr-search-missing-2-data .

arr:param-chaptarr-search-missing-2-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "const:{\"name\": \"BookSearch\", \"bookIds\": [<ids from step1>]}" .

arr:contract-prowlarr-fix-failing-indexer a arr:ToolUseContract ;
    rdfs:label "Fix a failing indexer" ;
    rdfs:comment "Find indexers Prowlarr has disabled after failures, read the failure, retest, and change the indexer settings only with approval." ;
    arr:contractOf arr:skill-arr-indexer-management ;
    arr:hasStep arr:step-prowlarr-fix-failing-indexer-1, arr:step-prowlarr-fix-failing-indexer-2, arr:step-prowlarr-fix-failing-indexer-3, arr:step-prowlarr-fix-failing-indexer-4, arr:step-prowlarr-fix-failing-indexer-5, arr:step-prowlarr-fix-failing-indexer-6, arr:step-prowlarr-fix-failing-indexer-7 .

arr:step-prowlarr-fix-failing-indexer-1 a arr:ContractStep ;
    arr:stepIndex 1 ;
    arr:callsTool arr:tool-prowlarr_get_indexerstatus ;
    arr:needsApproval false ;
    rdfs:comment "Each entry is a failing indexer (`indexerId`, `disabledTill`, `mostRecentFailure`)." ;
    arr:precedesStep arr:step-prowlarr-fix-failing-indexer-2 .

arr:step-prowlarr-fix-failing-indexer-2 a arr:ContractStep ;
    arr:stepIndex 2 ;
    arr:callsTool arr:tool-prowlarr_get_health ;
    arr:needsApproval false ;
    rdfs:comment "Health messages name the failing indexers and the reason." ;
    arr:precedesStep arr:step-prowlarr-fix-failing-indexer-3 .

arr:step-prowlarr-fix-failing-indexer-3 a arr:ContractStep ;
    arr:stepIndex 3 ;
    arr:callsTool arr:tool-prowlarr_get_indexer_id ;
    arr:needsApproval false ;
    rdfs:comment "Read the full indexer definition." ;
    arr:precedesStep arr:step-prowlarr-fix-failing-indexer-4 ;
    arr:bindsParameter arr:param-prowlarr-fix-failing-indexer-3-id .

arr:param-prowlarr-fix-failing-indexer-3-id a arr:ParameterBinding ;
    arr:parameterName "id" ;
    arr:parameterSource "step1.indexerId" .

arr:step-prowlarr-fix-failing-indexer-4 a arr:ContractStep ;
    arr:stepIndex 4 ;
    arr:callsTool arr:tool-prowlarr_post_indexer_test ;
    arr:needsApproval false ;
    rdfs:comment "A pass clears the failure; a Cloudflare error needs the FlareSolverr proxy tag." ;
    arr:precedesStep arr:step-prowlarr-fix-failing-indexer-5 ;
    arr:bindsParameter arr:param-prowlarr-fix-failing-indexer-4-data ;
    arr:bindsParameter arr:param-prowlarr-fix-failing-indexer-4-forceTest .

arr:param-prowlarr-fix-failing-indexer-4-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "step3" .

arr:param-prowlarr-fix-failing-indexer-4-forceTest a arr:ParameterBinding ;
    arr:parameterName "forceTest" ;
    arr:parameterSource "const:true" .

arr:step-prowlarr-fix-failing-indexer-5 a arr:ContractStep ;
    arr:stepIndex 5 ;
    arr:callsTool arr:tool-prowlarr_get_indexerproxy ;
    arr:needsApproval false ;
    rdfs:comment "The proxy (FlareSolverr) and its tag." ;
    arr:precedesStep arr:step-prowlarr-fix-failing-indexer-6 .

arr:step-prowlarr-fix-failing-indexer-6 a arr:ContractStep ;
    arr:stepIndex 6 ;
    arr:callsTool arr:tool-prowlarr_put_indexer_id ;
    arr:needsApproval true ;
    rdfs:comment "Approval required: changes a shared indexer." ;
    arr:precedesStep arr:step-prowlarr-fix-failing-indexer-7 ;
    arr:bindsParameter arr:param-prowlarr-fix-failing-indexer-6-id ;
    arr:bindsParameter arr:param-prowlarr-fix-failing-indexer-6-data .

arr:param-prowlarr-fix-failing-indexer-6-id a arr:ParameterBinding ;
    arr:parameterName "id" ;
    arr:parameterSource "step3.id" .

arr:param-prowlarr-fix-failing-indexer-6-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "step3 with the fix (tags, baseUrl, enable)" .

arr:step-prowlarr-fix-failing-indexer-7 a arr:ContractStep ;
    arr:stepIndex 7 ;
    arr:callsTool arr:tool-prowlarr_post_indexer_test ;
    arr:needsApproval false ;
    rdfs:comment "Confirm the fix." ;
    arr:bindsParameter arr:param-prowlarr-fix-failing-indexer-7-data ;
