    arr:bindsParameter arr:param-bazarr-download-wanted-subtitles-3-length .

arr:param-bazarr-download-wanted-subtitles-3-length a arr:ParameterBinding ;
    arr:parameterName "length" ;
    arr:parameterSource "const:50" .

arr:step-bazarr-download-wanted-subtitles-4 a arr:ContractStep ;
    arr:stepIndex 4 ;
    arr:callsTool arr:tool-bazarr_patch_episodes_subtitles ;
    arr:needsApproval false ;
