arr:contract-radarr-add-and-search a arr:ToolUseContract ;
    rdfs:label "Add a movie and search for it" ;
    rdfs:comment "Resolve the movie library location and quality profile, look the title up, add it monitored and start a search, then confirm it reached the download queue." ;
    arr:contractOf arr:skill-arr-movie-library ;
    arr:hasStep arr:step-radarr-add-and-search-1, arr:step-radarr-add-and-search-2, arr:step-radarr-add-and-search-3, arr:step-radarr-add-and-search-4, arr:step-radarr-add-and-search-5, arr:step-radarr-add-and-search-6 .

arr:step-radarr-add-and-search-1 a arr:ContractStep ;
    arr:stepIndex 1 ;
    arr:callsTool arr:tool-radarr_get_rootfolder ;
    arr:needsApproval false ;
    rdfs:comment "Pick the library root folder; use its `path`." ;
    arr:precedesStep arr:step-radarr-add-and-search-2 .

arr:step-radarr-add-and-search-2 a arr:ContractStep ;
    arr:stepIndex 2 ;
    arr:callsTool arr:tool-radarr_get_qualityprofile ;
    arr:needsApproval false ;
    rdfs:comment "Pick the quality profile the operator named (default the first); use its `id`." ;
    arr:precedesStep arr:step-radarr-add-and-search-3 .

arr:step-radarr-add-and-search-3 a arr:ContractStep ;
    arr:stepIndex 3 ;
    arr:callsTool arr:tool-radarr_get_movie_lookup ;
    arr:needsApproval false ;
    rdfs:comment "Confirm the right title and year before adding." ;
    arr:precedesStep arr:step-radarr-add-and-search-4 ;
    arr:bindsParameter arr:param-radarr-add-and-search-3-term .

arr:param-radarr-add-and-search-3-term a arr:ParameterBinding ;
    arr:parameterName "term" ;
    arr:parameterSource "input:title or tmdb:/tvdb: id" .

arr:step-radarr-add-and-search-4 a arr:ContractStep ;
    arr:stepIndex 4 ;
    arr:callsTool arr:tool-radarr_get_movie ;
    arr:needsApproval false ;
    rdfs:comment "Stop if the title is already in the library." ;
    arr:precedesStep arr:step-radarr-add-and-search-5 ;
    arr:bindsParameter arr:param-radarr-add-and-search-4-tmdbId .

arr:param-radarr-add-and-search-4-tmdbId a arr:ParameterBinding ;
    arr:parameterName "tmdbId" ;
    arr:parameterSource "step3.result[0].tmdbId" .

arr:step-radarr-add-and-search-5 a arr:ContractStep ;
    arr:stepIndex 5 ;
    arr:callsTool arr:tool-radarr_add_movie ;
    arr:needsApproval false ;
    rdfs:comment "Adds the title monitored and starts the search." ;
    arr:precedesStep arr:step-radarr-add-and-search-6 ;
    arr:bindsParameter arr:param-radarr-add-and-search-5-term ;
    arr:bindsParameter arr:param-radarr-add-and-search-5-root-folder-path ;
    arr:bindsParameter arr:param-radarr-add-and-search-5-quality-profile-id ;
    arr:bindsParameter arr:param-radarr-add-and-search-5-monitored ;
    arr:bindsParameter arr:param-radarr-add-and-search-5-search-for-movie .

arr:param-radarr-add-and-search-5-term a arr:ParameterBinding ;
    arr:parameterName "term" ;
    arr:parameterSource "input:title or tmdb:/tvdb: id" .

arr:param-radarr-add-and-search-5-root-folder-path a arr:ParameterBinding ;
    arr:parameterName "root_folder_path" ;
    arr:parameterSource "step1.result[0].path" .

arr:param-radarr-add-and-search-5-quality-profile-id a arr:ParameterBinding ;
    arr:parameterName "quality_profile_id" ;
    arr:parameterSource "step2.result[0].id" .

arr:param-radarr-add-and-search-5-monitored a arr:ParameterBinding ;
    arr:parameterName "monitored" ;
    arr:parameterSource "const:true" .

arr:param-radarr-add-and-search-5-search-for-movie a arr:ParameterBinding ;
    arr:parameterName "search_for_movie" ;
    arr:parameterSource "const:true" .

arr:step-radarr-add-and-search-6 a arr:ContractStep ;
    arr:stepIndex 6 ;
    arr:callsTool arr:tool-radarr_get_queue ;
    arr:needsApproval false ;
    rdfs:comment "A grabbed release shows here; an empty queue means no release matched yet." ;
    arr:bindsParameter arr:param-radarr-add-and-search-6-page ;
    arr:bindsParameter arr:param-radarr-add-and-search-6-pageSize .

arr:param-radarr-add-and-search-6-page a arr:ParameterBinding ;
    arr:parameterName "page" ;
    arr:parameterSource "const:1" .

arr:param-radarr-add-and-search-6-pageSize a arr:ParameterBinding ;
    arr:parameterName "pageSize" ;
    arr:parameterSource "const:20" .

arr:contract-radarr-search-missing a arr:ToolUseContract ;
    rdfs:label "Search for missing movie items" ;
    rdfs:comment "List the monitored items that have no file and start one search command for them." ;
    arr:contractOf arr:skill-arr-movie-library ;
    arr:hasStep arr:step-radarr-search-missing-1, arr:step-radarr-search-missing-2, arr:step-radarr-search-missing-3 .

arr:step-radarr-search-missing-1 a arr:ContractStep ;
    arr:stepIndex 1 ;
    arr:callsTool arr:tool-radarr_get_wanted_missing ;
    arr:needsApproval false ;
    rdfs:comment "Collect the ids of the missing items." ;
    arr:precedesStep arr:step-radarr-search-missing-2 ;
    arr:bindsParameter arr:param-radarr-search-missing-1-monitored ;
    arr:bindsParameter arr:param-radarr-search-missing-1-pageSize .

arr:param-radarr-search-missing-1-monitored a arr:ParameterBinding ;
    arr:parameterName "monitored" ;
    arr:parameterSource "const:true" .

arr:param-radarr-search-missing-1-pageSize a arr:ParameterBinding ;
    arr:parameterName "pageSize" ;
    arr:parameterSource "const:50" .

arr:step-radarr-search-missing-2 a arr:ContractStep ;
    arr:stepIndex 2 ;
    arr:callsTool arr:tool-radarr_post_command ;
    arr:needsApproval false ;
    rdfs:comment "One command per batch; never one per item." ;
    arr:precedesStep arr:step-radarr-search-missing-3 ;
    arr:bindsParameter arr:param-radarr-search-missing-2-data .

arr:param-radarr-search-missing-2-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "const:{\"name\": \"MoviesSearch\", \"movieIds\": \"<ids or id from step1>\"}" .

arr:step-radarr-search-missing-3 a arr:ContractStep ;
    arr:stepIndex 3 ;
    arr:callsTool arr:tool-radarr_get_queue ;
    arr:needsApproval false ;
    rdfs:comment "Confirm grabs." ;
    arr:bindsParameter arr:param-radarr-search-missing-3-page .

arr:param-radarr-search-missing-3-page a arr:ParameterBinding ;
    arr:parameterName "page" ;
    arr:parameterSource "const:1" .

arr:contract-radarr-tag-roundtrip a arr:ToolUseContract ;
    rdfs:label "Create and remove a label tag (reversible)" ;
    rdfs:comment "Create a tag to group items, verify it, and delete it again when it was only a test." ;
    arr:contractOf arr:skill-arr-movie-library ;
    arr:hasStep arr:step-radarr-tag-roundtrip-1, arr:step-radarr-tag-roundtrip-2, arr:step-radarr-tag-roundtrip-3 .

arr:step-radarr-tag-roundtrip-1 a arr:ContractStep ;
    arr:stepIndex 1 ;
    arr:callsTool arr:tool-radarr_get_tag ;
    arr:needsApproval false ;
    rdfs:comment "Reuse an existing tag with the same label." ;
    arr:precedesStep arr:step-radarr-tag-roundtrip-2 .

arr:step-radarr-tag-roundtrip-2 a arr:ContractStep ;
    arr:stepIndex 2 ;
    arr:callsTool arr:tool-radarr_post_tag ;
    arr:needsApproval false ;
    rdfs:comment "Labels are lower case." ;
    arr:precedesStep arr:step-radarr-tag-roundtrip-3 ;
    arr:bindsParameter arr:param-radarr-tag-roundtrip-2-data .

arr:param-radarr-tag-roundtrip-2-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "const:{\"label\": \"zz-validation-<date>\"}" .

arr:step-radarr-tag-roundtrip-3 a arr:ContractStep ;
    arr:stepIndex 3 ;
    arr:callsTool arr:tool-radarr_delete_tag_id ;
    arr:needsApproval true ;
    rdfs:comment "Only for tags this run created." ;
    arr:bindsParameter arr:param-radarr-tag-roundtrip-3-id ;
    arr:bindsParameter arr:param-radarr-tag-roundtrip-3-confirm .

arr:param-radarr-tag-roundtrip-3-id a arr:ParameterBinding ;
    arr:parameterName "id" ;
    arr:parameterSource "step2.id" .

arr:param-radarr-tag-roundtrip-3-confirm a arr:ParameterBinding ;
    arr:parameterName "confirm" ;
    arr:parameterSource "const:true" .

arr:contract-sonarr-add-and-search a arr:ToolUseContract ;
    rdfs:label "Add a series and search for it" ;
    rdfs:comment "Resolve the TV library location and quality profile, look the title up, add it monitored and start a search, then confirm it reached the download queue." ;
    arr:contractOf arr:skill-arr-series-library ;
    arr:hasStep arr:step-sonarr-add-and-search-1, arr:step-sonarr-add-and-search-2, arr:step-sonarr-add-and-search-3, arr:step-sonarr-add-and-search-4, arr:step-sonarr-add-and-search-5, arr:step-sonarr-add-and-search-6 .

arr:step-sonarr-add-and-search-1 a arr:ContractStep ;
    arr:stepIndex 1 ;
    arr:callsTool arr:tool-sonarr_get_rootfolder ;
    arr:needsApproval false ;
    rdfs:comment "Pick the library root folder; use its `path`." ;
    arr:precedesStep arr:step-sonarr-add-and-search-2 .

arr:step-sonarr-add-and-search-2 a arr:ContractStep ;
    arr:stepIndex 2 ;
    arr:callsTool arr:tool-sonarr_get_qualityprofile ;
    arr:needsApproval false ;
    rdfs:comment "Pick the quality profile the operator named (default the first); use its `id`." ;
    arr:precedesStep arr:step-sonarr-add-and-search-3 .

arr:step-sonarr-add-and-search-3 a arr:ContractStep ;
    arr:stepIndex 3 ;
    arr:callsTool arr:tool-sonarr_get_series_lookup ;
    arr:needsApproval false ;
    rdfs:comment "Confirm the right title and year before adding." ;
    arr:precedesStep arr:step-sonarr-add-and-search-4 ;
    arr:bindsParameter arr:param-sonarr-add-and-search-3-term .

arr:param-sonarr-add-and-search-3-term a arr:ParameterBinding ;
    arr:parameterName "term" ;
    arr:parameterSource "input:title or tmdb:/tvdb: id" .

arr:step-sonarr-add-and-search-4 a arr:ContractStep ;
    arr:stepIndex 4 ;
    arr:callsTool arr:tool-sonarr_get_series ;
    arr:needsApproval false ;
    rdfs:comment "Stop if the title is already in the library." ;
    arr:precedesStep arr:step-sonarr-add-and-search-5 ;
    arr:bindsParameter arr:param-sonarr-add-and-search-4-tvdbId .

arr:param-sonarr-add-and-search-4-tvdbId a arr:ParameterBinding ;
    arr:parameterName "tvdbId" ;
    arr:parameterSource "step3.result[0].tvdbId" .

arr:step-sonarr-add-and-search-5 a arr:ContractStep ;
    arr:stepIndex 5 ;
    arr:callsTool arr:tool-sonarr_add_series ;
    arr:needsApproval false ;
    rdfs:comment "Adds the title monitored and starts the search." ;
    arr:precedesStep arr:step-sonarr-add-and-search-6 ;
    arr:bindsParameter arr:param-sonarr-add-and-search-5-term ;
    arr:bindsParameter arr:param-sonarr-add-and-search-5-root-folder-path ;
    arr:bindsParameter arr:param-sonarr-add-and-search-5-quality-profile-id ;
    arr:bindsParameter arr:param-sonarr-add-and-search-5-monitored ;
    arr:bindsParameter arr:param-sonarr-add-and-search-5-search-for-missing-episodes .

arr:param-sonarr-add-and-search-5-term a arr:ParameterBinding ;
    arr:parameterName "term" ;
    arr:parameterSource "input:title or tmdb:/tvdb: id" .

arr:param-sonarr-add-and-search-5-root-folder-path a arr:ParameterBinding ;
    arr:parameterName "root_folder_path" ;
    arr:parameterSource "step1.result[0].path" .

arr:param-sonarr-add-and-search-5-quality-profile-id a arr:ParameterBinding ;
    arr:parameterName "quality_profile_id" ;
    arr:parameterSource "step2.result[0].id" .

arr:param-sonarr-add-and-search-5-monitored a arr:ParameterBinding ;
    arr:parameterName "monitored" ;
    arr:parameterSource "const:true" .

arr:param-sonarr-add-and-search-5-search-for-missing-episodes a arr:ParameterBinding ;
    arr:parameterName "search_for_missing_episodes" ;
    arr:parameterSource "const:true" .

arr:step-sonarr-add-and-search-6 a arr:ContractStep ;
    arr:stepIndex 6 ;
    arr:callsTool arr:tool-sonarr_get_queue ;
    arr:needsApproval false ;
    rdfs:comment "A grabbed release shows here; an empty queue means no release matched yet." ;
    arr:bindsParameter arr:param-sonarr-add-and-search-6-page ;
    arr:bindsParameter arr:param-sonarr-add-and-search-6-pageSize .

arr:param-sonarr-add-and-search-6-page a arr:ParameterBinding ;
    arr:parameterName "page" ;
    arr:parameterSource "const:1" .

arr:param-sonarr-add-and-search-6-pageSize a arr:ParameterBinding ;
    arr:parameterName "pageSize" ;
    arr:parameterSource "const:20" .

arr:contract-sonarr-search-missing a arr:ToolUseContract ;
    rdfs:label "Search for missing series items" ;
    rdfs:comment "List the monitored items that have no file and start one search command for them." ;
    arr:contractOf arr:skill-arr-series-library ;
    arr:hasStep arr:step-sonarr-search-missing-1, arr:step-sonarr-search-missing-2, arr:step-sonarr-search-missing-3 .

arr:step-sonarr-search-missing-1 a arr:ContractStep ;
    arr:stepIndex 1 ;
