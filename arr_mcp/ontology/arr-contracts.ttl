    rdfs:label "Add an author and search for their books" ;
    rdfs:comment "Resolve the book library location and profiles, look the author up and add them with a missing-book search. Stops when no root folder is configured." ;
    arr:contractOf arr:skill-arr-book-library ;
    arr:hasStep arr:step-chaptarr-add-author-and-search-1, arr:step-chaptarr-add-author-and-search-2, arr:step-chaptarr-add-author-and-search-3, arr:step-chaptarr-add-author-and-search-4, arr:step-chaptarr-add-author-and-search-5, arr:step-chaptarr-add-author-and-search-6 .

arr:step-chaptarr-add-author-and-search-1 a arr:ContractStep ;
    arr:stepIndex 1 ;
    arr:callsTool arr:tool-chaptarr_get_rootfolder ;
    arr:needsApproval false ;
    rdfs:comment "An empty list means the book library is not provisioned: stop and report it." ;
    arr:precedesStep arr:step-chaptarr-add-author-and-search-2 .

arr:step-chaptarr-add-author-and-search-2 a arr:ContractStep ;
    arr:stepIndex 2 ;
    arr:callsTool arr:tool-chaptarr_get_qualityprofile ;
    arr:needsApproval false ;
    rdfs:comment "E-Book or Audiobook profile; use its `id`." ;
    arr:precedesStep arr:step-chaptarr-add-author-and-search-3 .

arr:step-chaptarr-add-author-and-search-3 a arr:ContractStep ;
    arr:stepIndex 3 ;
    arr:callsTool arr:tool-chaptarr_get_metadataprofile ;
    arr:needsApproval false ;
    rdfs:comment "Use its `id`." ;
    arr:precedesStep arr:step-chaptarr-add-author-and-search-4 .

arr:step-chaptarr-add-author-and-search-4 a arr:ContractStep ;
    arr:stepIndex 4 ;
    arr:callsTool arr:tool-chaptarr_get_author_lookup ;
    arr:needsApproval false ;
    rdfs:comment "Pick the right author." ;
    arr:precedesStep arr:step-chaptarr-add-author-and-search-5 ;
    arr:bindsParameter arr:param-chaptarr-add-author-and-search-4-term .

arr:param-chaptarr-add-author-and-search-4-term a arr:ParameterBinding ;
    arr:parameterName "term" ;
    arr:parameterSource "input:author name" .

arr:step-chaptarr-add-author-and-search-5 a arr:ContractStep ;
    arr:stepIndex 5 ;
    arr:callsTool arr:tool-chaptarr_post_author ;
    arr:needsApproval false ;
    rdfs:comment "Adds and searches." ;
    arr:precedesStep arr:step-chaptarr-add-author-and-search-6 ;
    arr:bindsParameter arr:param-chaptarr-add-author-and-search-5-data .

arr:param-chaptarr-add-author-and-search-5-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "const:{\"foreignAuthorId\": \"<step4>\", \"authorName\": \"<step4>\", \"rootFolderPath\": \"<step1.path>\", \"qualityProfileId\": \"<step2.id>\", \"metadataProfileId\": \"<step3.id>\", \"monitored\": true, \"addOptions\": {\"searchForMissingBooks\": true}}" .

arr:step-chaptarr-add-author-and-search-6 a arr:ContractStep ;
    arr:stepIndex 6 ;
    arr:callsTool arr:tool-chaptarr_get_queue ;
    arr:needsApproval false ;
    rdfs:comment "Confirm grabs." ;
    arr:bindsParameter arr:param-chaptarr-add-author-and-search-6-page .

