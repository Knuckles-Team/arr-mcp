arr:param-lidarr-add-artist-and-search-6-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "const:{\"foreignArtistId\": \"<step4>\", \"artistName\": \"<step4>\", \"rootFolderPath\": \"<step1.path>\", \"qualityProfileId\": \"<step2.id>\", \"metadataProfileId\": \"<step3.id>\", \"monitored\": true, \"addOptions\": {\"searchForMissingAlbums\": true}}" .

arr:step-lidarr-add-artist-and-search-7 a arr:ContractStep ;
    arr:stepIndex 7 ;
