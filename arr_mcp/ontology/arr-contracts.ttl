    arr:bindsParameter arr:param-sonarr-search-missing-1-monitored ;
    arr:bindsParameter arr:param-sonarr-search-missing-1-pageSize .

arr:param-sonarr-search-missing-1-monitored a arr:ParameterBinding ;
    arr:parameterName "monitored" ;
    arr:parameterSource "const:true" .

arr:param-sonarr-search-missing-1-pageSize a arr:ParameterBinding ;
    arr:parameterName "pageSize" ;
    arr:parameterSource "const:50" .

arr:step-sonarr-search-missing-2 a arr:ContractStep ;
    arr:stepIndex 2 ;
    arr:callsTool arr:tool-sonarr_post_command ;
    arr:needsApproval false ;
    rdfs:comment "One command per batch; never one per item." ;
    arr:precedesStep arr:step-sonarr-search-missing-3 ;
    arr:bindsParameter arr:param-sonarr-search-missing-2-data .

arr:param-sonarr-search-missing-2-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "const:{\"name\": \"EpisodeSearch\", \"episodeIds\": \"<ids or id from step1>\"}" .

arr:step-sonarr-search-missing-3 a arr:ContractStep ;
    arr:stepIndex 3 ;
    arr:callsTool arr:tool-sonarr_get_queue ;
    arr:needsApproval false ;
    rdfs:comment "Confirm grabs." ;
    arr:bindsParameter arr:param-sonarr-search-missing-3-page .

arr:param-sonarr-search-missing-3-page a arr:ParameterBinding ;
    arr:parameterName "page" ;
    arr:parameterSource "const:1" .

arr:contract-sonarr-tag-roundtrip a arr:ToolUseContract ;
    rdfs:label "Create and remove a label tag (reversible)" ;
    rdfs:comment "Create a tag to group items, verify it, and delete it again when it was only a test." ;
    arr:contractOf arr:skill-arr-series-library ;
    arr:hasStep arr:step-sonarr-tag-roundtrip-1, arr:step-sonarr-tag-roundtrip-2, arr:step-sonarr-tag-roundtrip-3 .

arr:step-sonarr-tag-roundtrip-1 a arr:ContractStep ;
    arr:stepIndex 1 ;
    arr:callsTool arr:tool-sonarr_get_tag ;
    arr:needsApproval false ;
    rdfs:comment "Reuse an existing tag with the same label." ;
    arr:precedesStep arr:step-sonarr-tag-roundtrip-2 .

arr:step-sonarr-tag-roundtrip-2 a arr:ContractStep ;
    arr:stepIndex 2 ;
    arr:callsTool arr:tool-sonarr_post_tag ;
    arr:needsApproval false ;
    rdfs:comment "Labels are lower case." ;
    arr:precedesStep arr:step-sonarr-tag-roundtrip-3 ;
    arr:bindsParameter arr:param-sonarr-tag-roundtrip-2-data .

arr:param-sonarr-tag-roundtrip-2-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "const:{\"label\": \"zz-validation-<date>\"}" .

arr:step-sonarr-tag-roundtrip-3 a arr:ContractStep ;
    arr:stepIndex 3 ;
    arr:callsTool arr:tool-sonarr_delete_tag_id ;
    arr:needsApproval true ;
    rdfs:comment "Only for tags this run created." ;
    arr:bindsParameter arr:param-sonarr-tag-roundtrip-3-id ;
    arr:bindsParameter arr:param-sonarr-tag-roundtrip-3-confirm .

arr:param-sonarr-tag-roundtrip-3-id a arr:ParameterBinding ;
    arr:parameterName "id" ;
    arr:parameterSource "step2.id" .

arr:param-sonarr-tag-roundtrip-3-confirm a arr:ParameterBinding ;
    arr:parameterName "confirm" ;
    arr:parameterSource "const:true" .

