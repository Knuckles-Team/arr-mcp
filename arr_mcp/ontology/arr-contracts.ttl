arr:param-bazarr-download-wanted-subtitles-4-episodeid a arr:ParameterBinding ;
    arr:parameterName "episodeid" ;
    arr:parameterSource "step3.data[].sonarrEpisodeId" .

arr:param-bazarr-download-wanted-subtitles-4-language a arr:ParameterBinding ;
    arr:parameterName "language" ;
    arr:parameterSource "step3.data[].missing_subtitles[].code2" .

arr:param-bazarr-download-wanted-subtitles-4-forced a arr:ParameterBinding ;
    arr:parameterName "forced" ;
    arr:parameterSource "const:false" .

arr:param-bazarr-download-wanted-subtitles-4-hi a arr:ParameterBinding ;
    arr:parameterName "hi" ;
    arr:parameterSource "const:false" .

arr:step-bazarr-download-wanted-subtitles-5 a arr:ContractStep ;
    arr:stepIndex 5 ;
    arr:callsTool arr:tool-bazarr_get_movies_wanted ;
    arr:needsApproval false ;
