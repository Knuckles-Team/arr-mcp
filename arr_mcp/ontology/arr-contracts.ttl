    arr:bindsParameter arr:param-seerr-request-title-3-media-type ;
    arr:bindsParameter arr:param-seerr-request-title-3-media-id ;
    arr:bindsParameter arr:param-seerr-request-title-3-is4k .

arr:param-seerr-request-title-3-media-type a arr:ParameterBinding ;
    arr:parameterName "media_type" ;
