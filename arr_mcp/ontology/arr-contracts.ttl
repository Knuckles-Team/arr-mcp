arr:param-bazarr-download-wanted-subtitles-6-language a arr:ParameterBinding ;
    arr:parameterName "language" ;
    arr:parameterSource "step5.data[].missing_subtitles[].code2" .

arr:param-bazarr-download-wanted-subtitles-6-forced a arr:ParameterBinding ;
    arr:parameterName "forced" ;
    arr:parameterSource "const:false" .

arr:param-bazarr-download-wanted-subtitles-6-hi a arr:ParameterBinding ;
    arr:parameterName "hi" ;
    arr:parameterSource "const:false" .

arr:contract-bazarr-reset-providers a arr:ToolUseContract ;
