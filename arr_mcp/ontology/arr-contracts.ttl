    arr:bindsParameter arr:param-bazarr-download-wanted-subtitles-4-seriesid ;
    arr:bindsParameter arr:param-bazarr-download-wanted-subtitles-4-episodeid ;
    arr:bindsParameter arr:param-bazarr-download-wanted-subtitles-4-language ;
    arr:bindsParameter arr:param-bazarr-download-wanted-subtitles-4-forced ;
    arr:bindsParameter arr:param-bazarr-download-wanted-subtitles-4-hi .

