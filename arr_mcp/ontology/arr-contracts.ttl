arr:step-lidarr-add-artist-and-search-6 a arr:ContractStep ;
    arr:stepIndex 6 ;
    arr:callsTool arr:tool-lidarr_post_artist ;
    arr:needsApproval false ;
    rdfs:comment "Adds and searches." ;
