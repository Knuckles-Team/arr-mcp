arr:step-seerr-triage-requests-4 a arr:ContractStep ;
    arr:stepIndex 4 ;
    arr:callsTool arr:tool-seerr_get_service_radarr ;
    arr:needsApproval false ;
    rdfs:comment "Radarr servers a movie request routes to (4K flag, default)." ;
