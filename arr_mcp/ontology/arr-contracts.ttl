    arr:parameterSource "input:artist name or lidarr:<mbid>" .

arr:step-lidarr-add-artist-and-search-5 a arr:ContractStep ;
    arr:stepIndex 5 ;
    arr:callsTool arr:tool-lidarr_get_artist ;
    arr:needsApproval false ;
    rdfs:comment "Stop if already in the library." ;
    arr:precedesStep arr:step-lidarr-add-artist-and-search-6 ;
