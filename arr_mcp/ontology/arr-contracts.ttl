    arr:bindsParameter arr:param-lidarr-search-missing-2-data .

arr:param-lidarr-search-missing-2-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "const:{\"name\": \"AlbumSearch\", \"albumIds\": [<ids from step1>]}" .

arr:step-lidarr-search-missing-3 a arr:ContractStep ;
    arr:stepIndex 3 ;
    arr:callsTool arr:tool-lidarr_get_queue ;
    arr:needsApproval false ;
