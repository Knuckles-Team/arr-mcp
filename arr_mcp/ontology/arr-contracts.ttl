    arr:precedesStep arr:step-seerr-triage-requests-2 .

arr:step-seerr-triage-requests-2 a arr:ContractStep ;
    arr:stepIndex 2 ;
    arr:callsTool arr:tool-seerr_get_request ;
    arr:needsApproval false ;
    rdfs:comment "Pending requests with media and requester." ;
