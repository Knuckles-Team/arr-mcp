arr:param-prowlarr-fix-failing-indexer-7-forceTest a arr:ParameterBinding ;
    arr:parameterName "forceTest" ;
    arr:parameterSource "const:true" .

arr:contract-prowlarr-sync-indexers a arr:ToolUseContract ;
    rdfs:label "Sync indexers to the apps" ;
    rdfs:comment "Push the Prowlarr indexer pool to every connected app (Radarr, Sonarr, Lidarr)." ;
    arr:contractOf arr:skill-arr-indexer-management ;
    arr:hasStep arr:step-prowlarr-sync-indexers-1, arr:step-prowlarr-sync-indexers-2, arr:step-prowlarr-sync-indexers-3 .

arr:step-prowlarr-sync-indexers-1 a arr:ContractStep ;
    arr:stepIndex 1 ;
    arr:callsTool arr:tool-prowlarr_get_applications ;
    arr:needsApproval false ;
