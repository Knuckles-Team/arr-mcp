arr:step-prowlarr-sync-indexers-3 a arr:ContractStep ;
    arr:stepIndex 3 ;
    arr:callsTool arr:tool-radarr_get_indexer ;
    arr:needsApproval false ;
    rdfs:comment "The synced indexers appear in the app." .

arr:contract-prowlarr-search-releases a arr:ToolUseContract ;
    rdfs:label "Search releases across indexers" ;
