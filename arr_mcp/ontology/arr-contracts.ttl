arr:step-seerr-triage-requests-5 a arr:ContractStep ;
    arr:stepIndex 5 ;
    arr:callsTool arr:tool-seerr_get_service_sonarr ;
    arr:needsApproval false ;
    rdfs:comment "Sonarr servers a series request routes to." ;
