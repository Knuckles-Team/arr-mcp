# Workflows proven live on 2026-11-06 (CONN-ARR-MCP-SUITE-R011).

arr:tool-bazarr_get_system_settings a arr:ConnectorTool ;
    arr:toolName "bazarr_get_system_settings" ;
    arr:toolOf arr:app-bazarr .

arr:tool-bazarr_post_system_settings a arr:ConnectorTool ;
    arr:toolName "bazarr_post_system_settings" ;
    arr:toolOf arr:app-bazarr .

arr:tool-bazarr_post_system_tasks a arr:ConnectorTool ;
    arr:toolName "bazarr_post_system_tasks" ;
    arr:toolOf arr:app-bazarr .

arr:tool-bazarr_get_badges a arr:ConnectorTool ;
    arr:toolName "bazarr_get_badges" ;
    arr:toolOf arr:app-bazarr .

arr:contract-bazarr-connect-sonarr-radarr a arr:ToolUseContract ;
    rdfs:label "Connect Bazarr to Sonarr and Radarr" ;
    rdfs:comment "Point Bazarr at the Sonarr and Radarr instances, sync their series and movies, and confirm both links are live." ;
    arr:contractOf arr:skill-arr-subtitle-management ;
    arr:hasStep arr:step-bazarr-connect-sonarr-radarr-1, arr:step-bazarr-connect-sonarr-radarr-2, arr:step-bazarr-connect-sonarr-radarr-3, arr:step-bazarr-connect-sonarr-radarr-4, arr:step-bazarr-connect-sonarr-radarr-5, arr:step-bazarr-connect-sonarr-radarr-6 .

arr:step-bazarr-connect-sonarr-radarr-1 a arr:ContractStep ;
    arr:stepIndex 1 ;
    arr:callsTool arr:tool-bazarr_get_system_settings ;
    arr:needsApproval false ;
    rdfs:comment "`general.use_sonarr` / `general.use_radarr` false, or an empty `sonarr.apikey`, means the link is missing." ;
    arr:precedesStep arr:step-bazarr-connect-sonarr-radarr-2 .

arr:step-bazarr-connect-sonarr-radarr-2 a arr:ContractStep ;
    arr:stepIndex 2 ;
    arr:callsTool arr:tool-sonarr_get_system_status ;
    arr:needsApproval false ;
    rdfs:comment "Sonarr answers; Bazarr reaches it at the same host and port." ;
    arr:precedesStep arr:step-bazarr-connect-sonarr-radarr-3 .

arr:step-bazarr-connect-sonarr-radarr-3 a arr:ContractStep ;
    arr:stepIndex 3 ;
    arr:callsTool arr:tool-radarr_get_system_status ;
    arr:needsApproval false ;
    rdfs:comment "Radarr answers; Bazarr reaches it at the same host and port." ;
    arr:precedesStep arr:step-bazarr-connect-sonarr-radarr-4 .

arr:step-bazarr-connect-sonarr-radarr-4 a arr:ContractStep ;
    arr:stepIndex 4 ;
    arr:callsTool arr:tool-bazarr_post_system_settings ;
    arr:needsApproval true ;
    rdfs:comment "Approval required: saves the connection. Keys come from the credential store (SONARR_API_KEY, RADARR_API_KEY), never from chat." ;
    arr:precedesStep arr:step-bazarr-connect-sonarr-radarr-5 ;
    arr:bindsParameter arr:param-bazarr-connect-sonarr-radarr-4-settings .

arr:param-bazarr-connect-sonarr-radarr-4-settings a arr:ParameterBinding ;
    arr:parameterName "settings" ;
    arr:parameterSource "{settings-general-use_sonarr: true, settings-sonarr-ip, settings-sonarr-port, settings-sonarr-base_url: \"/\", settings-sonarr-apikey: secret SONARR_API_KEY, settings-general-use_radarr: true, settings-radarr-ip, settings-radarr-port, settings-radarr-base_url: \"/\", settings-radarr-apikey: secret RADARR_API_KEY}" .

arr:step-bazarr-connect-sonarr-radarr-5 a arr:ContractStep ;
    arr:stepIndex 5 ;
    arr:callsTool arr:tool-bazarr_post_system_tasks ;
    arr:needsApproval false ;
    rdfs:comment "Sync series from Sonarr now instead of waiting for the hourly job." ;
    arr:precedesStep arr:step-bazarr-connect-sonarr-radarr-6 ;
    arr:bindsParameter arr:param-bazarr-connect-sonarr-radarr-5-taskid .

arr:param-bazarr-connect-sonarr-radarr-5-taskid a arr:ParameterBinding ;
    arr:parameterName "taskid" ;
    arr:parameterSource "const:\"update_series\"" .

arr:step-bazarr-connect-sonarr-radarr-6 a arr:ContractStep ;
    arr:stepIndex 6 ;
    arr:callsTool arr:tool-bazarr_get_badges ;
    arr:needsApproval false ;
    rdfs:comment "`sonarr_signalr` and `radarr_signalr` read `LIVE` once both links work; `episodes` / `movies` count what is missing subtitles." .

arr:tool-bazarr_get_languages_profiles a arr:ConnectorTool ;
    arr:toolName "bazarr_get_languages_profiles" ;
    arr:toolOf arr:app-bazarr .

arr:tool-bazarr_get_provider_movies a arr:ConnectorTool ;
    arr:toolName "bazarr_get_provider_movies" ;
    arr:toolOf arr:app-bazarr .

arr:tool-bazarr_get_provider_episodes a arr:ConnectorTool ;
    arr:toolName "bazarr_get_provider_episodes" ;
    arr:toolOf arr:app-bazarr .

arr:contract-bazarr-enable-free-providers a arr:ToolUseContract ;
    rdfs:label "Enable free subtitle providers and the default language profile" ;
    rdfs:comment "Enable the subtitle providers that need no account, create the default language profile, and prove a search returns subtitles for one movie and one episode." ;
    arr:contractOf arr:skill-arr-subtitle-management ;
    arr:hasStep arr:step-bazarr-enable-free-providers-1, arr:step-bazarr-enable-free-providers-2, arr:step-bazarr-enable-free-providers-3, arr:step-bazarr-enable-free-providers-4, arr:step-bazarr-enable-free-providers-5, arr:step-bazarr-enable-free-providers-6, arr:step-bazarr-enable-free-providers-7, arr:step-bazarr-enable-free-providers-8 .

arr:step-bazarr-enable-free-providers-1 a arr:ContractStep ;
    arr:stepIndex 1 ;
    arr:callsTool arr:tool-bazarr_get_system_settings ;
    arr:needsApproval false ;
    rdfs:comment "`general.enabled_providers` lists the enabled providers; the provider sections show which need credentials." ;
    arr:precedesStep arr:step-bazarr-enable-free-providers-2 .

arr:step-bazarr-enable-free-providers-2 a arr:ContractStep ;
    arr:stepIndex 2 ;
    arr:callsTool arr:tool-bazarr_get_languages_profiles ;
    arr:needsApproval false ;
    rdfs:comment "An empty list means no language profile: nothing is wanted." ;
    arr:precedesStep arr:step-bazarr-enable-free-providers-3 .

arr:step-bazarr-enable-free-providers-3 a arr:ContractStep ;
    arr:stepIndex 3 ;
    arr:callsTool arr:tool-bazarr_post_system_settings ;
    arr:needsApproval true ;
    rdfs:comment "Approval required: enables the no-account providers (Bazarr 1.6.2: embeddedsubtitles, gestdown, subtitlecat, supersubtitles, tvsubtitles, yifysubtitles), enables the language, saves the profile and makes it the series and movie default." ;
    arr:precedesStep arr:step-bazarr-enable-free-providers-4 ;
    arr:bindsParameter arr:param-bazarr-enable-free-providers-3-settings .

arr:param-bazarr-enable-free-providers-3-settings a arr:ParameterBinding ;
    arr:parameterName "settings" ;
    arr:parameterSource "{settings-general-enabled_providers: [...], languages-enabled: [\"en\"], languages-profiles: JSON [{profileId: 1, name: \"English\", items: [{id: 1, language: \"en\", hi: \"False\", forced: \"False\", audio_exclude: \"False\", audio_only_include: \"False\"}], cutoff: null, mustContain: [], mustNotContain: [], originalFormat: false}], settings-general-serie_default_enabled: true, settings-general-serie_default_profile: 1, settings-general-movie_default_enabled: true, settings-general-movie_default_profile: 1}" .

arr:step-bazarr-enable-free-providers-4 a arr:ContractStep ;
    arr:stepIndex 4 ;
    arr:callsTool arr:tool-bazarr_get_providers ;
    arr:needsApproval false ;
    rdfs:comment "Each enabled provider reads `Good`; a throttled one names its retry time." ;
    arr:precedesStep arr:step-bazarr-enable-free-providers-5 .

arr:step-bazarr-enable-free-providers-5 a arr:ContractStep ;
    arr:stepIndex 5 ;
    arr:callsTool arr:tool-bazarr_get_movies_wanted ;
    arr:needsApproval false ;
    rdfs:comment "Pick one movie missing subtitles (`radarrId`)." ;
    arr:precedesStep arr:step-bazarr-enable-free-providers-6 ;
    arr:bindsParameter arr:param-bazarr-enable-free-providers-5-length .

arr:param-bazarr-enable-free-providers-5-length a arr:ParameterBinding ;
    arr:parameterName "length" ;
    arr:parameterSource "const:5" .

arr:step-bazarr-enable-free-providers-6 a arr:ContractStep ;
    arr:stepIndex 6 ;
    arr:callsTool arr:tool-bazarr_get_provider_movies ;
    arr:needsApproval false ;
    rdfs:comment "Manual search across the providers; results name provider, language and score. Can take minutes." ;
    arr:precedesStep arr:step-bazarr-enable-free-providers-7 ;
    arr:bindsParameter arr:param-bazarr-enable-free-providers-6-radarrid .

arr:param-bazarr-enable-free-providers-6-radarrid a arr:ParameterBinding ;
    arr:parameterName "radarrid" ;
    arr:parameterSource "step5.data[0].radarrId" .

arr:step-bazarr-enable-free-providers-7 a arr:ContractStep ;
    arr:stepIndex 7 ;
    arr:callsTool arr:tool-bazarr_get_episodes_wanted ;
    arr:needsApproval false ;
    rdfs:comment "Pick one episode missing subtitles (`sonarrEpisodeId`)." ;
    arr:precedesStep arr:step-bazarr-enable-free-providers-8 ;
    arr:bindsParameter arr:param-bazarr-enable-free-providers-7-length .

arr:param-bazarr-enable-free-providers-7-length a arr:ParameterBinding ;
    arr:parameterName "length" ;
    arr:parameterSource "const:5" .

arr:step-bazarr-enable-free-providers-8 a arr:ContractStep ;
    arr:stepIndex 8 ;
    arr:callsTool arr:tool-bazarr_get_provider_episodes ;
    arr:needsApproval false ;
    rdfs:comment "Manual search for the episode; results name provider, language and score." ;
    arr:bindsParameter arr:param-bazarr-enable-free-providers-8-episodeid .

arr:param-bazarr-enable-free-providers-8-episodeid a arr:ParameterBinding ;
    arr:parameterName "episodeid" ;
    arr:parameterSource "step7.data[0].sonarrEpisodeId" .

arr:tool-radarr_get_downloadclient a arr:ConnectorTool ;
    arr:toolName "radarr_get_downloadclient" ;
    arr:toolOf arr:app-radarr .

arr:tool-radarr_post_downloadclient_test a arr:ConnectorTool ;
    arr:toolName "radarr_post_downloadclient_test" ;
    arr:toolOf arr:app-radarr .

arr:tool-radarr_put_downloadclient_id a arr:ConnectorTool ;
    arr:toolName "radarr_put_downloadclient_id" ;
    arr:toolOf arr:app-radarr .

arr:contract-arr-repair-download-client a arr:ToolUseContract ;
    rdfs:label "Repair an unavailable download client" ;
    rdfs:comment "When an app reports every download client unavailable, read the client's own failure reason, fix the setting with approval and confirm the test passes." ;
    arr:contractOf arr:skill-arr-download-queue ;
    arr:hasStep arr:step-arr-repair-download-client-1, arr:step-arr-repair-download-client-2, arr:step-arr-repair-download-client-3, arr:step-arr-repair-download-client-4, arr:step-arr-repair-download-client-5 .

arr:step-arr-repair-download-client-1 a arr:ContractStep ;
    arr:stepIndex 1 ;
    arr:callsTool arr:tool-radarr_get_health ;
    arr:needsApproval false ;
    rdfs:comment "`All download clients are unavailable due to failures` starts this workflow (the same for sonarr_, lidarr_ and chaptarr_)." ;
    arr:precedesStep arr:step-arr-repair-download-client-2 .

arr:step-arr-repair-download-client-2 a arr:ContractStep ;
    arr:stepIndex 2 ;
    arr:callsTool arr:tool-radarr_get_downloadclient ;
    arr:needsApproval false ;
    rdfs:comment "The configured client, host, port and category." ;
    arr:precedesStep arr:step-arr-repair-download-client-3 .

arr:step-arr-repair-download-client-3 a arr:ContractStep ;
    arr:stepIndex 3 ;
    arr:callsTool arr:tool-radarr_post_downloadclient_test ;
    arr:needsApproval false ;
    rdfs:comment "The error carries the app's reason: `Host: Unable to connect to qBittorrent` (the client banned the caller after failed logins) or `Username: Authentication failure` (stale password)." ;
    arr:precedesStep arr:step-arr-repair-download-client-4 ;
    arr:bindsParameter arr:param-arr-repair-download-client-3-data .

arr:param-arr-repair-download-client-3-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "step2.result[0]" .

arr:step-arr-repair-download-client-4 a arr:ContractStep ;
    arr:stepIndex 4 ;
    arr:callsTool arr:tool-radarr_put_downloadclient_id ;
    arr:needsApproval true ;
    rdfs:comment "Approval required: saves the current username and password from the credential store (QBITTORRENT_USERNAME, QBITTORRENT_PASSWORD). `forceSave` skips the test, because a banned caller fails it until the ban lifts or qBittorrent restarts." ;
    arr:precedesStep arr:step-arr-repair-download-client-5 ;
    arr:bindsParameter arr:param-arr-repair-download-client-4-id ;
    arr:bindsParameter arr:param-arr-repair-download-client-4-data ;
    arr:bindsParameter arr:param-arr-repair-download-client-4-forceSave .

arr:param-arr-repair-download-client-4-id a arr:ParameterBinding ;
    arr:parameterName "id" ;
    arr:parameterSource "step2.result[0].id" .

arr:param-arr-repair-download-client-4-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "step2.result[0] with the stored credentials" .

arr:param-arr-repair-download-client-4-forceSave a arr:ParameterBinding ;
    arr:parameterName "forceSave" ;
    arr:parameterSource "const:true" .

arr:step-arr-repair-download-client-5 a arr:ContractStep ;
    arr:stepIndex 5 ;
    arr:callsTool arr:tool-radarr_post_downloadclient_test ;
    arr:needsApproval false ;
    rdfs:comment "Passes once the client accepts the login; repeat for each app that shares the client." ;
    arr:bindsParameter arr:param-arr-repair-download-client-5-data .

arr:param-arr-repair-download-client-5-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "step2.result[0]" .

arr:tool-chaptarr_post_rootfolder a arr:ConnectorTool ;
    arr:toolName "chaptarr_post_rootfolder" ;
    arr:toolOf arr:app-chaptarr .

arr:tool-chaptarr_get_downloadclient_schema a arr:ConnectorTool ;
    arr:toolName "chaptarr_get_downloadclient_schema" ;
    arr:toolOf arr:app-chaptarr .

arr:tool-chaptarr_post_downloadclient_test a arr:ConnectorTool ;
    arr:toolName "chaptarr_post_downloadclient_test" ;
    arr:toolOf arr:app-chaptarr .

arr:tool-chaptarr_post_downloadclient a arr:ConnectorTool ;
    arr:toolName "chaptarr_post_downloadclient" ;
    arr:toolOf arr:app-chaptarr .

arr:tool-prowlarr_get_applications_schema a arr:ConnectorTool ;
    arr:toolName "prowlarr_get_applications_schema" ;
    arr:toolOf arr:app-prowlarr .

arr:tool-prowlarr_post_applications_test a arr:ConnectorTool ;
    arr:toolName "prowlarr_post_applications_test" ;
    arr:toolOf arr:app-prowlarr .

arr:tool-prowlarr_post_applications a arr:ConnectorTool ;
    arr:toolName "prowlarr_post_applications" ;
    arr:toolOf arr:app-prowlarr .

arr:contract-chaptarr-provision-book-library a arr:ToolUseContract ;
    rdfs:label "Provision the book library" ;
    rdfs:comment "Give Chaptarr its book root folder, qBittorrent as download client, and a Prowlarr link for book indexers." ;
    arr:contractOf arr:skill-arr-book-library ;
    arr:hasStep arr:step-chaptarr-provision-book-library-1, arr:step-chaptarr-provision-book-library-2, arr:step-chaptarr-provision-book-library-3, arr:step-chaptarr-provision-book-library-4, arr:step-chaptarr-provision-book-library-5, arr:step-chaptarr-provision-book-library-6, arr:step-chaptarr-provision-book-library-7, arr:step-chaptarr-provision-book-library-8, arr:step-chaptarr-provision-book-library-9, arr:step-chaptarr-provision-book-library-10 .

arr:step-chaptarr-provision-book-library-1 a arr:ContractStep ;
    arr:stepIndex 1 ;
    arr:callsTool arr:tool-chaptarr_get_rootfolder ;
    arr:needsApproval false ;
    rdfs:comment "An empty result means no library." ;
    arr:precedesStep arr:step-chaptarr-provision-book-library-2 .

arr:step-chaptarr-provision-book-library-2 a arr:ContractStep ;
    arr:stepIndex 2 ;
    arr:callsTool arr:tool-chaptarr_get_qualityprofile ;
    arr:needsApproval false ;
    rdfs:comment "The ebook and audiobook quality profiles (`profileType`)." ;
    arr:precedesStep arr:step-chaptarr-provision-book-library-3 .

arr:step-chaptarr-provision-book-library-3 a arr:ContractStep ;
    arr:stepIndex 3 ;
    arr:callsTool arr:tool-chaptarr_get_metadataprofile ;
    arr:needsApproval false ;
    rdfs:comment "The ebook and audiobook metadata profiles." ;
    arr:precedesStep arr:step-chaptarr-provision-book-library-4 .

arr:step-chaptarr-provision-book-library-4 a arr:ContractStep ;
    arr:stepIndex 4 ;
    arr:callsTool arr:tool-chaptarr_post_rootfolder ;
    arr:needsApproval true ;
    rdfs:comment "Approval required: adds the folder. Chaptarr needs `folderType` (1 audiobook, 2 ebook, 0 mixed) and the matching `ebookQualityProfileId` / `ebookMetadataProfileId` (or the audiobook pair)." ;
    arr:precedesStep arr:step-chaptarr-provision-book-library-5 ;
    arr:bindsParameter arr:param-chaptarr-provision-book-library-4-data .

arr:param-chaptarr-provision-book-library-4-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "{name: \"Books\", path: \"/ebooks\", folderType: 2, ebookQualityProfileId: step2 ebook id, ebookMetadataProfileId: step3 ebook id, defaultMonitorOption: \"all\", defaultNewItemMonitorOption: \"all\"}" .

arr:step-chaptarr-provision-book-library-5 a arr:ContractStep ;
    arr:stepIndex 5 ;
    arr:callsTool arr:tool-chaptarr_get_downloadclient_schema ;
    arr:needsApproval false ;
    rdfs:comment "The `QBittorrent` entry with its fields; categories default to `chaptarr`." ;
    arr:precedesStep arr:step-chaptarr-provision-book-library-6 .

arr:step-chaptarr-provision-book-library-6 a arr:ContractStep ;
    arr:stepIndex 6 ;
    arr:callsTool arr:tool-chaptarr_post_downloadclient_test ;
    arr:needsApproval false ;
    rdfs:comment "Tests the client with the stored qBittorrent credentials." ;
    arr:precedesStep arr:step-chaptarr-provision-book-library-7 ;
    arr:bindsParameter arr:param-chaptarr-provision-book-library-6-data .

arr:param-chaptarr-provision-book-library-6-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "step5 QBittorrent entry with host, port and credentials" .

arr:step-chaptarr-provision-book-library-7 a arr:ContractStep ;
    arr:stepIndex 7 ;
    arr:callsTool arr:tool-chaptarr_post_downloadclient ;
    arr:needsApproval true ;
    rdfs:comment "Approval required: saves the client." ;
    arr:precedesStep arr:step-chaptarr-provision-book-library-8 ;
    arr:bindsParameter arr:param-chaptarr-provision-book-library-7-data .

arr:param-chaptarr-provision-book-library-7-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "step6 data" .

arr:step-chaptarr-provision-book-library-8 a arr:ContractStep ;
    arr:stepIndex 8 ;
    arr:callsTool arr:tool-prowlarr_get_applications_schema ;
    arr:needsApproval false ;
    rdfs:comment "Chaptarr speaks the Readarr API: use the `Readarr` entry." ;
    arr:precedesStep arr:step-chaptarr-provision-book-library-9 .

arr:step-chaptarr-provision-book-library-9 a arr:ContractStep ;
    arr:stepIndex 9 ;
    arr:callsTool arr:tool-prowlarr_post_applications_test ;
    arr:needsApproval false ;
    rdfs:comment "Tests the link with Chaptarr's base URL and API key (CHAPTARR_API_KEY)." ;
    arr:precedesStep arr:step-chaptarr-provision-book-library-10 ;
    arr:bindsParameter arr:param-chaptarr-provision-book-library-9-data .

arr:param-chaptarr-provision-book-library-9-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "step8 Readarr entry with baseUrl and apiKey" .

arr:step-chaptarr-provision-book-library-10 a arr:ContractStep ;
    arr:stepIndex 10 ;
    arr:callsTool arr:tool-prowlarr_post_applications ;
    arr:needsApproval true ;
    rdfs:comment "Approval required: adds the link with `syncLevel` fullSync, so Prowlarr pushes its book indexers." ;
    arr:bindsParameter arr:param-chaptarr-provision-book-library-10-data .

arr:param-chaptarr-provision-book-library-10-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "step9 data" .

arr:tool-prowlarr_get_indexer_schema a arr:ConnectorTool ;
    arr:toolName "prowlarr_get_indexer_schema" ;
    arr:toolOf arr:app-prowlarr .

arr:tool-prowlarr_post_indexer a arr:ConnectorTool ;
    arr:toolName "prowlarr_post_indexer" ;
    arr:toolOf arr:app-prowlarr .

arr:tool-prowlarr_delete_indexer_id a arr:ConnectorTool ;
    arr:toolName "prowlarr_delete_indexer_id" ;
    arr:toolOf arr:app-prowlarr .

arr:contract-prowlarr-replace-dead-indexer a arr:ToolUseContract ;
    rdfs:label "Replace a permanently dead indexer" ;
    rdfs:comment "After the fix-a-failing-indexer workflow shows an indexer cannot work (domain gone, TLS broken on every mirror, Cloudflare the proxy cannot solve), add a tested public replacement, remove the dead one and sync the apps." ;
    arr:contractOf arr:skill-arr-indexer-management ;
    arr:hasStep arr:step-prowlarr-replace-dead-indexer-1, arr:step-prowlarr-replace-dead-indexer-2, arr:step-prowlarr-replace-dead-indexer-3, arr:step-prowlarr-replace-dead-indexer-4, arr:step-prowlarr-replace-dead-indexer-5 .

arr:step-prowlarr-replace-dead-indexer-1 a arr:ContractStep ;
    arr:stepIndex 1 ;
    arr:callsTool arr:tool-prowlarr_get_indexer_schema ;
    arr:needsApproval false ;
    rdfs:comment "Every definition with its `indexerUrls` mirrors; pick a replacement that covers the same categories." ;
    arr:precedesStep arr:step-prowlarr-replace-dead-indexer-2 .

arr:step-prowlarr-replace-dead-indexer-2 a arr:ContractStep ;
    arr:stepIndex 2 ;
    arr:callsTool arr:tool-prowlarr_post_indexer_test ;
    arr:needsApproval false ;
    rdfs:comment "Test the candidate before adding it; try each mirror in `indexerUrls`." ;
    arr:precedesStep arr:step-prowlarr-replace-dead-indexer-3 ;
    arr:bindsParameter arr:param-prowlarr-replace-dead-indexer-2-data ;
    arr:bindsParameter arr:param-prowlarr-replace-dead-indexer-2-forceTest .

arr:param-prowlarr-replace-dead-indexer-2-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "step1 definition with baseUrl set" .

arr:param-prowlarr-replace-dead-indexer-2-forceTest a arr:ParameterBinding ;
    arr:parameterName "forceTest" ;
    arr:parameterSource "const:true" .

arr:step-prowlarr-replace-dead-indexer-3 a arr:ContractStep ;
    arr:stepIndex 3 ;
    arr:callsTool arr:tool-prowlarr_post_indexer ;
    arr:needsApproval true ;
    rdfs:comment "Approval required: adds the replacement." ;
    arr:precedesStep arr:step-prowlarr-replace-dead-indexer-4 ;
    arr:bindsParameter arr:param-prowlarr-replace-dead-indexer-3-data .

arr:param-prowlarr-replace-dead-indexer-3-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "step2 data" .

arr:step-prowlarr-replace-dead-indexer-4 a arr:ContractStep ;
    arr:stepIndex 4 ;
    arr:callsTool arr:tool-prowlarr_delete_indexer_id ;
    arr:needsApproval true ;
    rdfs:comment "Approval required: removes the dead indexer (destructive; pass `confirm=true` after approval)." ;
    arr:precedesStep arr:step-prowlarr-replace-dead-indexer-5 ;
    arr:bindsParameter arr:param-prowlarr-replace-dead-indexer-4-id .

arr:param-prowlarr-replace-dead-indexer-4-id a arr:ParameterBinding ;
    arr:parameterName "id" ;
    arr:parameterSource "the dead indexer id" .

arr:step-prowlarr-replace-dead-indexer-5 a arr:ContractStep ;
    arr:stepIndex 5 ;
    arr:callsTool arr:tool-prowlarr_post_command ;
    arr:needsApproval false ;
    rdfs:comment "Push the indexer change to every linked app." ;
    arr:bindsParameter arr:param-prowlarr-replace-dead-indexer-5-data .

arr:param-prowlarr-replace-dead-indexer-5-data a arr:ParameterBinding ;
    arr:parameterName "data" ;
    arr:parameterSource "const:{\"name\": \"ApplicationIndexerSync\"}" .

