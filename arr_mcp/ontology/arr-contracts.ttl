arr:contract-seerr-route-requests-by-quality a arr:ToolUseContract ;
    rdfs:label "Route normal requests at 1080p and 4K requests at 4K" ;
    rdfs:comment "Give Seerr a default non-4K Radarr and Sonarr server with the 1080p profile, and keep the 4K servers for 4K requests with the 4K profile." ;
    arr:contractOf arr:skill-arr-media-requests ;
    arr:hasStep arr:step-seerr-route-requests-by-quality-1, arr:step-seerr-route-requests-by-quality-2, arr:step-seerr-route-requests-by-quality-3, arr:step-seerr-route-requests-by-quality-4, arr:step-seerr-route-requests-by-quality-5, arr:step-seerr-route-requests-by-quality-6, arr:step-seerr-route-requests-by-quality-7, arr:step-seerr-route-requests-by-quality-8 .

arr:step-seerr-route-requests-by-quality-1 a arr:ContractStep ;
    arr:stepIndex 1 ;
    arr:callsTool arr:tool-seerr_get_settings_radarr ;
    arr:needsApproval false ;
    rdfs:comment "Each server's `is4k`, `isDefault` and profile. Normal requests go to the default server with `is4k` false; none means they have no route." ;
    arr:precedesStep arr:step-seerr-route-requests-by-quality-2 .

arr:step-seerr-route-requests-by-quality-2 a arr:ContractStep ;
    arr:stepIndex 2 ;
    arr:callsTool arr:tool-radarr_get_qualityprofile ;
    arr:needsApproval false ;
    rdfs:comment "The 1080p and 4K profile ids." ;
    arr:precedesStep arr:step-seerr-route-requests-by-quality-3 .

arr:step-seerr-route-requests-by-quality-3 a arr:ContractStep ;
    arr:stepIndex 3 ;
    arr:callsTool arr:tool-seerr_post_settings_radarr_test ;
    arr:needsApproval false ;
    rdfs:comment "Seerr reaches Radarr and reads its profiles." ;
    arr:precedesStep arr:step-seerr-route-requests-by-quality-4 ;
    arr:bindsParameter arr:param-seerr-route-requests-by-quality-3-hostname ;
    arr:bindsParameter arr:param-seerr-route-requests-by-quality-3-port ;
    arr:bindsParameter arr:param-seerr-route-requests-by-quality-3-api_key ;
    arr:bindsParameter arr:param-seerr-route-requests-by-quality-3-use_ssl .

arr:param-seerr-route-requests-by-quality-3-hostname a arr:ParameterBinding ;
    arr:parameterName "hostname" ;
    arr:parameterSource "the Radarr host" .

arr:param-seerr-route-requests-by-quality-3-port a arr:ParameterBinding ;
    arr:parameterName "port" ;
    arr:parameterSource "the Radarr port" .

arr:param-seerr-route-requests-by-quality-3-api_key a arr:ParameterBinding ;
    arr:parameterName "api_key" ;
    arr:parameterSource "secret RADARR_API_KEY" .

arr:param-seerr-route-requests-by-quality-3-use_ssl a arr:ParameterBinding ;
    arr:parameterName "use_ssl" ;
    arr:parameterSource "const:false" .

arr:step-seerr-route-requests-by-quality-4 a arr:ContractStep ;
    arr:stepIndex 4 ;
    arr:callsTool arr:tool-seerr_post_settings_radarr ;
    arr:needsApproval true ;
    rdfs:comment "Approval required: adds the default non-4K server with the 1080p profile." ;
    arr:precedesStep arr:step-seerr-route-requests-by-quality-5 ;
    arr:bindsParameter arr:param-seerr-route-requests-by-quality-4-is4k ;
    arr:bindsParameter arr:param-seerr-route-requests-by-quality-4-is_default ;
    arr:bindsParameter arr:param-seerr-route-requests-by-quality-4-active_profile_id .

arr:param-seerr-route-requests-by-quality-4-is4k a arr:ParameterBinding ;
    arr:parameterName "is4k" ;
    arr:parameterSource "const:false" .

arr:param-seerr-route-requests-by-quality-4-is_default a arr:ParameterBinding ;
    arr:parameterName "is_default" ;
    arr:parameterSource "const:true" .

arr:param-seerr-route-requests-by-quality-4-active_profile_id a arr:ParameterBinding ;
    arr:parameterName "active_profile_id" ;
    arr:parameterSource "step2 1080p id" .

arr:step-seerr-route-requests-by-quality-5 a arr:ContractStep ;
    arr:stepIndex 5 ;
    arr:callsTool arr:tool-seerr_put_settings_radarr_id ;
    arr:needsApproval true ;
    rdfs:comment "Approval required: the 4K server keeps `is4k` true (default only among 4K servers) and takes the 4K profile." ;
    arr:precedesStep arr:step-seerr-route-requests-by-quality-6 ;
    arr:bindsParameter arr:param-seerr-route-requests-by-quality-5-radarr_id ;
    arr:bindsParameter arr:param-seerr-route-requests-by-quality-5-active_profile_id .

arr:param-seerr-route-requests-by-quality-5-radarr_id a arr:ParameterBinding ;
    arr:parameterName "radarr_id" ;
    arr:parameterSource "the 4K server id" .

arr:param-seerr-route-requests-by-quality-5-active_profile_id a arr:ParameterBinding ;
    arr:parameterName "active_profile_id" ;
    arr:parameterSource "step2 4K id" .

arr:step-seerr-route-requests-by-quality-6 a arr:ContractStep ;
    arr:stepIndex 6 ;
    arr:callsTool arr:tool-seerr_get_settings_sonarr ;
    arr:needsApproval false ;
    rdfs:comment "The same check for Sonarr." ;
    arr:precedesStep arr:step-seerr-route-requests-by-quality-7 .

arr:step-seerr-route-requests-by-quality-7 a arr:ContractStep ;
    arr:stepIndex 7 ;
    arr:callsTool arr:tool-seerr_post_settings_sonarr ;
    arr:needsApproval true ;
    rdfs:comment "Approval required: adds the default non-4K Sonarr server with the 1080p profile (also for anime)." ;
    arr:precedesStep arr:step-seerr-route-requests-by-quality-8 ;
    arr:bindsParameter arr:param-seerr-route-requests-by-quality-7-is4k ;
    arr:bindsParameter arr:param-seerr-route-requests-by-quality-7-is_default .

arr:param-seerr-route-requests-by-quality-7-is4k a arr:ParameterBinding ;
    arr:parameterName "is4k" ;
    arr:parameterSource "const:false" .

arr:param-seerr-route-requests-by-quality-7-is_default a arr:ParameterBinding ;
    arr:parameterName "is_default" ;
    arr:parameterSource "const:true" .

arr:step-seerr-route-requests-by-quality-8 a arr:ContractStep ;
    arr:stepIndex 8 ;
    arr:callsTool arr:tool-seerr_put_settings_sonarr_id ;
    arr:needsApproval true ;
    rdfs:comment "Approval required: the 4K Sonarr server takes the 4K profile." ;
    arr:bindsParameter arr:param-seerr-route-requests-by-quality-8-sonarr_id .

arr:param-seerr-route-requests-by-quality-8-sonarr_id a arr:ParameterBinding ;
    arr:parameterName "sonarr_id" ;
    arr:parameterSource "the 4K server id" .
