arr:param-bazarr-reset-providers-2-action a arr:ParameterBinding ;
    arr:parameterName "action" ;
    arr:parameterSource "const:\"reset\"" .

arr:contract-seerr-triage-requests a arr:ToolUseContract ;
    rdfs:label "Triage pending requests" ;
    rdfs:comment "Count and list pending requests, read each one, check where it will route, and approve or decline it with approval." ;
    arr:contractOf arr:skill-arr-media-requests ;
    arr:hasStep arr:step-seerr-triage-requests-1, arr:step-seerr-triage-requests-2, arr:step-seerr-triage-requests-3, arr:step-seerr-triage-requests-4, arr:step-seerr-triage-requests-5, arr:step-seerr-triage-requests-6 .

